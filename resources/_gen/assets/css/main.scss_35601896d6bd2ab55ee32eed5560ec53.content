der-bottom:solid 2px #000000}.art-hover-filter{background:#eae0ff;opacity:0.0}.art-header:hover .art-hover-filter{opacity:0.5}.art-thumbnail{position:relative;z-index:1;box-sizing:border-box;padding:0.5rem;padding-top:20rem;padding-bottom:0.5rem}.art-bg-image{position:absolute;top:0;right:0;bottom:0;left:0;object-fit:cover;height:100%;width:100%;z-index:-10}.games-container{display:flex;flex-wrap:wrap;list-style:none;justify-content:center;padding-left:0;gap:1rem}.games-post{width:calc(30% - 0.5rem);box-sizing:border-box;border:solid 2px #000000}@media (max-width: 500px){.games-post{width:100%}}.games-post a{text-decoration:none;width:100%;display:block}.games-header{background-color:#e3e3e300;border-bottom:solid 2px #000000}.games-hover-filter{background:#eae0ff;opacity:0.0}.games-header:hover .games-hover-filter{opacity:0.5}.games-thumbnail{position:relative;z-index:1;box-sizing:border-box;padding:0.5rem;padding-top:13rem;padding-bottom:0.5rem}.games-bg-image{position:absolute;top:0;right:0;bottom:0;left:0;object-fit:cover;height:100%;width:100%;z-index:-10}.about-container{display:flex;flex-wrap:wrap;list-style:none;justify-content:center;padding-left:0;gap:1rem}.about-post{width:calc(30% - 0.5rem);box-sizing:border-box;border:solid 2px #000000}@media (max-width: 500px){.about-post{width:100%}}.about-post a{text-decoration:none;width:100%;display:block}.about-header{background-color:#e3e3e300;border-bottom:solid 2px #000000}.about-hover-filter{background:#eae0ff;opacity:0.0}.about-header:hover .about-hover-filter{opacity:0.5}.about-thumbnail{position:relative;z-index:1;box-sizing:border-box;padding:3rem;padding-top:5rem;padding-bottom:0.5rem}.about-bg-image{position:absolute;top:0;right:0;bottom:0;left:0;object-fit:cover;height:100%;width:100%;z-index:-10}.socials{display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;padding-bottom:1rem}

